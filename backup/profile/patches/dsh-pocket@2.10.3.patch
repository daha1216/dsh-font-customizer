+  [data-mobile-nav="frame"] [data-phase] header [role="tablist"] {
+    flex-wrap: nowrap;
+    gap: 0 16px;
+    overflow-x: auto;
+    overscroll-behavior-x: contain;
+    scroll-snap-type: x proximity;
